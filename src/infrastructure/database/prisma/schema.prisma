// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// Base Entidades de Seguridad y Organización (Hito 2)
// ------------------------------------------------------

model Tenant {
  id          String   @id @default(uuid())
  name        String
  created_at  DateTime @default(now())
  created_by  String?
  updated_at  DateTime @updatedAt
  updated_by  String?
  is_deleted  Boolean  @default(false)
  deleted_at  DateTime?
  deleted_by  String?
  version     Int      @default(1)

  branches    Branch[]
  auditLogs   AuditLog[]

  @@map("tenants")
}

model Branch {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String
  created_at  DateTime @default(now())
  created_by  String?
  updated_at  DateTime @updatedAt
  updated_by  String?
  is_deleted  Boolean  @default(false)
  deleted_at  DateTime?
  deleted_by  String?
  version     Int      @default(1)

  tenant      Tenant   @relation(fields: [tenant_id], references: [id])
  
  @@map("branches")
}

// ------------------------------------------------------
// Base Entidades de Auditoría Universal (Hito 2)
// ------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  tenant_id   String
  branch_id   String?
  user_id     String?
  entity_type String   // Ej: 'Equipo', 'Empleado'
  entity_id   String
  action      String   // Ej: 'CREATE', 'UPDATE', 'DELETE'
  module      String   // Ej: 'logistica', 'rrhh'
  ip_address  String?
  duration_ms Int?
  result      String   // 'SUCCESS' o 'ERROR'
  created_at  DateTime @default(now())
  
  changes     AuditChange[]
  tenant      Tenant   @relation(fields: [tenant_id], references: [id])

  @@map("audit_logs")
}

model AuditChange {
  id            String   @id @default(uuid())
  audit_log_id  String
  field_name    String
  old_value     String?  // JSON string
  new_value     String?  // JSON string
  
  auditLog      AuditLog @relation(fields: [audit_log_id], references: [id])

  @@map("audit_changes")
}

// ------------------------------------------------------
// Event Sourcing & Outbox Pattern (Hito 2)
// ------------------------------------------------------

model DomainEvent {
  id            String   @id @default(uuid())
  aggregate_id  String
  event_name    String
  payload       String   // JSON string
  created_at    DateTime @default(now())
  processed     Boolean  @default(false)

  @@map("domain_events")
}

model OutboxEvent {
  id            String   @id @default(uuid())
  event_name    String
  payload       String   // JSON string
  status        String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  attempts      Int      @default(0)
  last_error    String?
  next_retry    DateTime?
  created_at    DateTime @default(now())
  processed_at  DateTime?

  @@map("outbox_events")
}

// ------------------------------------------------------
// Módulo de Seguridad (Hito 14)
// ------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String
  description String?
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  is_deleted  Boolean  @default(false)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // Ej: 'recepcion:create', 'rrhh:view'
  module      String
  description String?

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       String
  permission_id String

  role          Role       @relation(fields: [role_id], references: [id])
  permission    Permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model UserRole {
  user_id   String
  role_id   String
  tenant_id String

  role      Role     @relation(fields: [role_id], references: [id])

  @@id([user_id, role_id, tenant_id])
  @@map("user_roles")
}

// ------------------------------------------------------
// Feature Flags (Hito 16)
// ------------------------------------------------------

model FeatureFlag {
  id          String   @id @default(uuid())
  tenant_id   String
  branch_id   String?  // Opcional, si aplica solo a una sucursal
  code        String   // Ej: 'USE_NEW_RECEPTION_UI'
  is_enabled  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([tenant_id, branch_id, code])
  @@map("feature_flags")
}

// ------------------------------------------------------
// Bounded Context: Logística Inversa (Hito 17)
// ------------------------------------------------------

model LogEquipo {
  id               String   @id @default(uuid())
  tenant_id        String
  branch_id        String
  numero_serie     String
  marca            String?
  modelo           String?
  tipo_dispositivo String?
  
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  is_deleted       Boolean  @default(false)

  ordenes          LogOrdenServicio[]

  @@map("log_equipos")
}

model LogOrdenServicio {
  id                 String   @id @default(uuid())
  tenant_id          String
  branch_id          String
  equipo_id          String
  
  tipo_recepcion     String   // 'CAC' o 'PX'
  estado_recepcion   String   // 'INGRESADO', 'EN_REVISION', etc
  diagnostico_inicial String?
  falla_reportada    String?
  
  // Datos específicos PX (si aplica)
  guia_px            String?
  transporte         String?
  
  created_at         DateTime @default(now())
  created_by         String?
  updated_at         DateTime @updatedAt
  is_deleted         Boolean  @default(false)

  equipo             LogEquipo @relation(fields: [equipo_id], references: [id])

  @@map("log_ordenes_servicio")
}

// ------------------------------------------------------
// Bounded Context: Producción / Taller (Hito 21)
// ------------------------------------------------------

model ProdDiagnostico {
  id               String   @id @default(uuid())
  tenant_id        String
  branch_id        String
  orden_logistica_id String @unique // Vinculo con LogOrdenServicio
  tecnico_id       String?
  estado           String   // 'PENDIENTE', 'EN_PROCESO', 'COMPLETADO'
  observaciones    String?
  
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  is_deleted       Boolean  @default(false)

  reparacion       ProdReparacion?

  @@map("prod_diagnosticos")
}

model ProdReparacion {
  id               String   @id @default(uuid())
  tenant_id        String
  branch_id        String
  diagnostico_id   String   @unique
  tecnico_id       String?
  estado           String   // 'ESPERA_REPUESTOS', 'REPARANDO', 'PRUEBAS', 'FINALIZADO'
  repuestos_usados String?  // JSON con repuestos (simplificado)
  tiempo_invertido Int?     // Minutos
  
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  is_deleted       Boolean  @default(false)

  diagnostico      ProdDiagnostico @relation(fields: [diagnostico_id], references: [id])

  @@map("prod_reparaciones")
}

// ------------------------------------------------------
// Bounded Context: Inventario / Abastecimiento (Hito 25)
// ------------------------------------------------------

model InvArticulo {
  id             String   @id @default(uuid())
  tenant_id      String
  branch_id      String
  codigo         String   @unique
  nombre         String
  tipo           String   // 'REPUESTO', 'EQUIPO', 'CONSUMIBLE'
  stock_actual   Int      @default(0)
  stock_minimo   Int      @default(0)
  precio_unitario Float   @default(0)

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  is_deleted     Boolean  @default(false)

  movimientos    InvMovimiento[]

  @@map("inv_articulos")
}

model InvMovimiento {
  id             String   @id @default(uuid())
  tenant_id      String
  branch_id      String
  articulo_id    String
  tipo           String   // 'INGRESO', 'SALIDA', 'AJUSTE'
  cantidad       Int
  motivo         String?
  referencia_id  String?  // Ej: ID de la reparación o de la orden de compra

  created_at     DateTime @default(now())
  created_by     String?

  articulo       InvArticulo @relation(fields: [articulo_id], references: [id])

  @@map("inv_movimientos")
}

// ------------------------------------------------------
// Bounded Context: Recursos Humanos (RRHH) (Hito 29)
// ------------------------------------------------------

model RrhhEmpleado {
  id             String   @id @default(uuid())
  tenant_id      String
  branch_id      String
  user_id        String?  @unique // Opcional, enlace con el sistema de Auth (Supabase Auth)
  nombre         String
  apellido       String
  dni            String   @unique
  cargo          String
  departamento   String
  estado         String   @default("ACTIVO") // 'ACTIVO', 'VACACIONES', 'INACTIVO'

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  is_deleted     Boolean  @default(false)

  asistencias    RrhhAsistencia[]
  desempenos     RrhhDesempeno[]

  @@map("rrhh_empleados")
}

model RrhhAsistencia {
  id             String   @id @default(uuid())
  tenant_id      String
  branch_id      String
  empleado_id    String
  fecha          DateTime @db.Date
  entrada        DateTime?
  salida         DateTime?
  tipo           String   // 'PRESENCIAL', 'REMOTO', 'FALTA', 'PERMISO'

  created_at     DateTime @default(now())

  empleado       RrhhEmpleado @relation(fields: [empleado_id], references: [id])

  @@map("rrhh_asistencias")
}

model RrhhDesempeno {
  id                     String   @id @default(uuid())
  tenant_id              String
  branch_id              String
  empleado_id            String
  mes                    Int
  anio                   Int
  equipos_diagnosticados Int      @default(0)
  reparaciones_exitosas  Int      @default(0)
  reparaciones_fallidas  Int      @default(0)

  updated_at             DateTime @updatedAt

  empleado               RrhhEmpleado @relation(fields: [empleado_id], references: [id])

  @@unique([empleado_id, mes, anio])
  @@map("rrhh_desempenos")
}

// ------------------------------------------------------
// Bounded Context: Despacho (Hito 33)
// ------------------------------------------------------

model DespachoOrden {
  id             String   @id @default(uuid())
  tenant_id      String
  branch_id      String
  reparacion_id  String   @unique // Enlace lógico con Producción
  cliente_nombre String
  equipo_info    String
  estado         String   @default("PENDIENTE") // 'PENDIENTE', 'EN_RUTA', 'ENTREGADO'
  direccion      String?
  tracking_code  String?
  fecha_entrega  DateTime?

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  is_deleted     Boolean  @default(false)

  @@map("desp_ordenes")
}

// Fin del esquema.
