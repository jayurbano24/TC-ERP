{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run download:insightface && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit",
    "test:unit": "vitest run --exclude src/scripts/export-prediagnostico-all.test.ts",
    "test:watch": "vitest",
    "test:integration:prediagnostico": "vitest run src/scripts/export-prediagnostico-all.test.ts --testTimeout=900000",
    "export:prediagnostico": "npx --yes tsx scripts/export-prediagnostico.ts",
    "export:prediagnostico:sample100": "npx --yes tsx scripts/export-prediagnostico-sample-100.ts",
    "export:prediagnostico:range": "npx --yes tsx scripts/export-prediagnostico-range.ts",
    "open:prediagnostico-export": "explorer.exe dist",
    "export:sap:en-planta": "npx --yes tsx scripts/export-sap-en-planta.ts --format=csv",
    "export:sap:en-planta:xlsx": "npx --yes tsx scripts/export-sap-en-planta.ts --format=xlsx",
    "open:sap-en-planta-export": "explorer.exe dist",
    "export:prediagnostico:test": "npm run test:integration:prediagnostico",
    "backfill:prediagnostico": "vitest run src/scripts/run-prediagnostico-backfill-apply.test.ts --testTimeout=86400000",
    "prediag:faltantes": "npx --yes tsx scripts/run-prediagnostico-backfill-faltantes.ts",
    "ops:os-salida": "npx --yes tsx scripts/batch-os-salida.ts",
    "ops:os-salida:paste": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/paste-os-salida-list.ps1",
    "ops:serial-salida": "npx --yes tsx scripts/batch-serial-salida.ts",
    "ops:serial-salida:paste": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/paste-serial-salida-list.ps1",
    "ops:serial-salida:force": "npx --yes tsx scripts/batch-serial-salida-force.ts",
    "open:os-salida-export": "explorer.exe dist",
    "ci:quality": "npm run test:unit && npm run check:architecture",
    "check:architecture": "node scripts/check-architecture.js",
    "check:architecture:strict": "node scripts/check-architecture.js --strict",
    "check:architecture:baseline": "node scripts/check-architecture.js --update-baseline",
    "supabase:bootstrap:assemble": "node scripts/assemble-erp-bootstrap-migration.mjs",
    "supabase:hr:assemble": "node scripts/assemble-hr-legacy-migration.mjs",
    "supabase:verify:assemble": "node scripts/verify-bootstrap-reproducibility.mjs",
    "supabase:verify:migrations": "node scripts/verify-migration-filenames.mjs",
    "supabase:validate:index": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-from-git-index.ps1",
    "supabase:validate:index:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-index-full.ps1",
    "supabase:isolated:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/supabase-isolated-reset.ps1",
    "supabase:upgrade:init": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/supabase-isolated-upgrade-init.ps1",
    "supabase:upgrade:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/supabase-isolated-upgrade-restore.ps1",
    "supabase:upgrade:wipe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/supabase-isolated-upgrade-wipe.ps1",
    "supabase:upgrade:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/supabase-isolated-upgrade-migrate.ps1",
    "supabase:upgrade:plan": "node scripts/upgrade/compute-migration-plan.mjs",
    "supabase:upgrade:sync-migration-index": "node scripts/upgrade/sync-target-migration-index.mjs",
    "supabase:upgrade:prepare-manifest": "node scripts/upgrade/sync-target-migration-index.mjs && node scripts/upgrade/prepare-package-manifest.mjs",
    "supabase:upgrade:manifest": "node scripts/upgrade/generate-package-manifest.mjs",
    "supabase:upgrade:validate-package-index": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-upgrade-package-from-git-index.ps1",
    "test:upgrade:package": "vitest run scripts/upgrade/upgrade-validation-package.test.mjs",
    "supabase:upgrade:checks": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-upgrade-validation-checks.ps1",
    "supabase:upgrade:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-classify-upgrade-stack.ps1",
    "supabase:upgrade:recovery": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/supabase-isolated-upgrade-recovery-drill.ps1",
    "test:classify:fullstack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-classify-fullstack.ps1",
    "apply:phase-a-events": "node scripts/apply_platform_events_phase_a.js",
    "download:insightface": "node scripts/download-insightface-models.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-virtual": "^3.14.3",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.474.0",
    "next": "16.2.4",
    "onnxruntime-web": "^1.22.0",
    "papaparse": "^5.5.3",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-barcode": "^1.6.1",
    "react-dom": "19.2.4",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^3.2.6"
  }
}
