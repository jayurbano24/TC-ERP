# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# InsightFace ONNX + ORT wasm (descargar con npm run download:insightface)
/public/models/insightface/*.onnx
/public/onnx/
/.tmp-insightface/

# agent/dev scratch files (one-off scripts, transcripts, extractions)
/scratch/
/.npm-cache/
/tmp/
/query_*.js
/apply_*.js
/_*.py
/_*.txt
scripts/_*
scripts/write-backoffice-*
scripts/backoffice_six_contents.py
scripts/*_six_files.js
**/_extract_*.py
**/_wire_*.py
**/_migrate_*.py
**/_commit_msg.txt
